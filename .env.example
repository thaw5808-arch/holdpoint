# Postgres (Neon: use the direct/unpooled URL for db push + seed)
DATABASE_URL="postgresql://user:password@host/holdpoint?sslmode=require"

# Session cookie signing key: openssl rand -base64 32
SESSION_SECRET="replace-me"

# Cloudflare R2 (S3-compatible) — private bucket, avatars served through
# an app route rather than exposed directly. Account ID and an API token
# with Object Read & Write come from the R2 dashboard.
R2_ACCOUNT_ID="replace-me"
R2_ACCESS_KEY_ID="replace-me"
R2_SECRET_ACCESS_KEY="replace-me"
R2_BUCKET="replace-me"

# "Continue with Google" — OAuth 2.0 client from the Google Cloud Console.
# Authorized redirect URI must be http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID="replace-me"
GOOGLE_CLIENT_SECRET="replace-me"
